  // ============================================================================
  // Project: Next.js + TypeScript + React 19
  // Package Manager: pnpm (v10.20.0)
  // Node.js: LTS/Krypton (v20.x)
  // ============================================================================

  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[javascriptreact]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
