    "**/build": true,
    "**/.turbo": true,
    "**/.cache": true,
    "**/coverage": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/tmp": true,
    "**/.temp": true,
    "**/.idea": true,
    "**/.vscode-test": true
  },
